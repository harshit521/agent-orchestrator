# Copy to apps/api/.env (loaded automatically) or export these variables.
# Nothing here is required for the offline demo: the default provider is `stub`.

# --- server ---
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# --- persistence ---
# Relative paths are resolved against apps/api.
DATABASE_URL=file:./data/taskfleet.db

# --- LLM provider ---
# stub | openai | anthropic
# The stub is deliberately offline and cannot call tools, so it cannot drive the
# coding agent. Use openai or anthropic for real coding runs.
LLM_PROVIDER=stub
# Required for openai/anthropic. Never commit real keys.
LLM_API_KEY=
# Optional model override (defaults: gpt-4o-mini / claude-sonnet-4-5)
LLM_MODEL=
# Optional base URL for OpenAI-compatible gateways (OpenRouter, Groq, vLLM...)
LLM_BASE_URL=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=60000

# --- GitHub integration (optional) ---
# Required together with GITHUB_REPOSITORY to push branches and open PRs.
GITHUB_TOKEN=
# owner/repository
GITHUB_REPOSITORY=
# Secret configured on the GitHub webhook; required to enable /webhooks/github
GITHUB_WEBHOOK_SECRET=
# Branch that agent branches are based on and PRs target.
GITHUB_BASE_BRANCH=main
# Optional remote URL override (defaults to https://github.com/<owner>/<repo>.git).
GITHUB_REMOTE_URL=

# --- git worktree isolation ---
# Coding agents always need worktrees; disable only for research-only deployments.
WORKTREES_ENABLED=true
# Worktrees are created under this directory (default: .taskfleet/worktrees)
WORKTREES_ROOT=
# Keep the worktree after a successful/failed run. Set false to clean up.
WORKTREE_KEEP_ON_SUCCESS=true
WORKTREE_KEEP_ON_FAILURE=true

# --- coding agent limits and verification ---
AGENT_MAX_STEPS=20
AGENT_MAX_TOKENS=100000
AGENT_MAX_TOOL_CALLS=80
AGENT_COMMAND_TIMEOUT_MS=120000
AGENT_TEST_TIMEOUT_MS=180000
# Run the repository test suite automatically after the agent finishes.
AGENT_RUN_TESTS=true
# Fail the run when the agent made no file changes.
AGENT_REQUIRE_CHANGES=true
# Override auto-detection (npm test / pytest / go test / cargo test).
AGENT_TEST_COMMAND=
# Comma-separated executables the agent may run. There is no shell.
AGENT_COMMAND_ALLOWLIST=npm,npx,node,pnpm,yarn,python,python3,pytest,go,cargo,make

# --- git identity for agent commits ---
GIT_AUTHOR_NAME=TaskFleet Agent
GIT_AUTHOR_EMAIL=agent@taskfleet.local

# --- security scanner (optional) ---
SECURITY_ENABLED=false
