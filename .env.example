# Copy to apps/api/.env (loaded automatically) or export these variables.
# Nothing here is required for the offline demo: the default provider is `stub`.

# --- server ---
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# --- persistence ---
# Relative paths are resolved against apps/api.
DATABASE_URL=file:./data/taskfleet.db

# --- LLM provider ---
# stub | openai | anthropic
LLM_PROVIDER=stub
# Required for openai/anthropic. Never commit real keys.
LLM_API_KEY=
# Optional model override (defaults: gpt-4o-mini / claude-sonnet-4-5)
LLM_MODEL=
# Optional base URL for OpenAI-compatible gateways (OpenRouter, Groq, vLLM...)
LLM_BASE_URL=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=60000

# --- GitHub integration (optional) ---
GITHUB_TOKEN=
# owner/repository
GITHUB_REPOSITORY=
# Secret configured on the GitHub webhook; required to enable /webhooks/github
GITHUB_WEBHOOK_SECRET=

# --- isolation / security (optional) ---
WORKTREES_ENABLED=false
# Worktrees are created under this directory (default: .taskfleet/worktrees)
WORKTREES_ROOT=
SECURITY_ENABLED=false
