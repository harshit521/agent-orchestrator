// TaskFleet persistence model.
// SQLite is used for local development and demos; the schema maps to
// PostgreSQL without changes beyond the datasource provider.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Task {
  id        String   @id @default(cuid())
  title     String
  prompt    String
  agentId   String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs Run[]

  @@index([status])
  @@index([createdAt])
}

model Run {
  id          String    @id @default(cuid())
  taskId      String
  agentId     String
  status      String
  provider    String?
  model       String?
  output      String?
  errorCode   String?
  errorMessage String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  task   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  events RunEvent[]

  @@index([taskId])
  @@index([status])
}

model RunEvent {
  id        String   @id @default(cuid())
  runId     String
  type      String
  stage     String?
  message   String
  percent   Int?
  data      String?
  createdAt DateTime @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}
